# ./setup.sh --service copies this file; PM2 reads it on startOrReload.
POSTGRES_USER=conjectures
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tensor
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
# DATABASE_URL overrides the PostgreSQL fields; URL-encode its password.

# Generate with scripts/exact-config.py; review before running.
COMPETITION_CONFIG=competition.toml
BENCHMARK_ENVIRONMENT=local
BENCH_CPU=3
# Host systemd/user namespaces must support these limits.
GATE_BUILD_MEMORY_MB=4096
GATE_BENCH_MEMORY_MB=512
GATE_TASKS_MAX=256
GATE_FILE_MB=512
GATE_BUILD_DISK_MB=1024

NETUID=66
BITTENSOR_NETWORK=finney
BITTENSOR_ARCHIVE_NETWORK=archive
BITTENSOR_WALLET_NAME=default
BITTENSOR_WALLET_HOTKEY=default
WEIGHT_DRY_RUN=1
# WEIGHT_TREASURY_HOTKEY=
# WEIGHT_BURN_MODE=0
# WEIGHT_SET_MARGIN=12
# WEIGHT_POLL_SECONDS=12

# Optional central API Docker network and dedicated role.
# COMPOSE_FILE=compose.yaml:deploy/platform/compose.yaml
# PLATFORM_NETWORK=conjectures-api_default
# PLATFORM_API_PASSWORD=

# Optional event delivery; the events each process sends are listed in docs/OPERATIONS.md.
# AXIOM_TOKEN=
# AXIOM_DATASET=conjectures-validator
# AXIOM_ENVIRON=dev
# AXIOM_URL=https://api.axiom.co
# The coordinator, hardware workers and auditor all use these settings.
# Notifications are configured on Axiom monitors, not with a worker webhook secret.
# See docs/AXIOM-MONITORING.md for monitor queries and credential requirements.

# Optional per-worker restricted credentials (administrator-generated JSON, mode 0600).
# TENSOR_BENCHMARK_CREDENTIALS=/secure/benchmark.json
# TENSOR_AUDITOR_ENABLED=1
# TENSOR_AUDITOR_CREDENTIALS=/secure/auditor.json

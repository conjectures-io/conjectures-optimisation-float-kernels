# Copied to .env by setup.sh --service; pm2/service.config.js loads .env.
# Every value below is the default; delete a line to keep the default.

# --- The gate ---------------------------------------------------------------------
# The incumbent every submission is timed against. Promote a winner by pointing this at
# its Kernel.lean (copy it somewhere stable first); the pinned binary rebuilds on its own.
#GATE_INCUMBENT=submissions/incumbent/Kernel.lean
# The core both benches run on; pick an idle one on the validator.
#BENCH_CPU=3
#BENCH_ROUNDS=25
# Seconds the service gives the whole gate per submission; over it is a rejection.
VERIFY_TOTAL_TIMEOUT=1800
# A kernel at or below this ratio to the incumbent qualifies for promotion.
PROMOTION_BAR=0.97

# --- The store --------------------------------------------------------------------
# Postgres from compose.yaml. DATABASE_URL, if set, overrides all five.
POSTGRES_USER=conjectures
POSTGRES_PASSWORD=change-me
POSTGRES_DB=floatlib
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
#DATABASE_URL=postgresql+psycopg://user:pass@host:5433/floatlib

# --- The submission API -----------------------------------------------------------
SERVICE_HOST=0.0.0.0
SERVICE_PORT=9300
# Where each submission's Kernel.lean is written; relative to the repository.
SERVICE_FILES=validator/.work/submissions
# Signed writes per hotkey per minute.
SERVICE_RATE_PER_MINUTE=10
# How far a submission's signed timestamp may be from the validator's clock.
SERVICE_SIGNATURE_WINDOW_SECONDS=300
# Host header allowlist, comma-separated; "*" behind a filtering proxy.
SERVICE_ALLOWED_HOSTS=*
# Unique per gate worker; the default carries the hostname and pid.
#SERVICE_WORKER_ID=
# Must exceed VERIFY_TOTAL_TIMEOUT, or a slow but live verification gets stolen.
#SERVICE_STALE_CLAIM_SECONDS=7200

# --- The chain (./setup.sh --chain) -----------------------------------------------
NETUID=66
BITTENSOR_NETWORK=finney
BITTENSOR_ARCHIVE_NETWORK=archive
#CHAIN_POLL_SECONDS=6
# The validator's own wallet; its hotkey must be registered on NETUID.
BITTENSOR_WALLET_NAME=default
BITTENSOR_WALLET_HOTKEY=default
#BITTENSOR_WALLET_PATH=~/.bittensor/wallets
# Compute and record the vector without submitting it.
#WEIGHT_DRY_RUN=1
# Emit everything to the burn uid, ignoring scores (a paused round).
#WEIGHT_BURN_MODE=1
#WEIGHT_BURN_UID=0
# The leader's share of emission under the king-of-the-hill placeholder; the rest burns.
#WEIGHT_WINNER_SHARE=1.0

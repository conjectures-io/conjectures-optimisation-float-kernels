# Copied to .env by setup.sh --service; deploy/pm2.config.js loads .env.
# Every value below is the default; delete a line to keep the default.

# --- Logging -----------------------------------------------------------------------
# Console level for the gate and every service process (DEBUG, INFO, WARNING); the gate's
# logs/*.log files always keep DEBUG.
#LOG_LEVEL=INFO

# --- The gate ---------------------------------------------------------------------
# The incumbent every entry is timed against; the full entry's is the one that pays. Promote a
# winner by pointing this at its Kernel.lean (copy it somewhere stable first); the pinned binary
# rebuilds on its own.
#GATE_INCUMBENT_FULL=kernels/full/incumbent/Kernel.lean
# Each practice board has its own: GATE_INCUMBENT (add), GATE_INCUMBENT_MUL, _SUM, _BMM, ...
#GATE_INCUMBENT=kernels/add/incumbent/Kernel.lean
# The core both benches run on; pick an idle one on the validator.
#BENCH_CPU=3
#BENCH_ROUNDS=25
# Per-command caps for the gate's sandbox, applied through a user systemd scope (no swap).
# 0 lifts a memory cap; a host without a user systemd session needs `loginctl enable-linger`.
#GATE_BUILD_MEMORY_MB=4096
#GATE_BENCH_MEMORY_MB=512
#GATE_TASKS_MAX=256
# Seconds an entry's own builds, kernel replays and bench runs may take in all; running out is a
# charged rejection, so a slow file cannot hold the gate for free.
#GATE_BUDGET_SECONDS=600
# Seconds the service gives the whole gate per submission; over it is a rejection.
VERIFY_TOTAL_TIMEOUT=1800
# Informational fingerprint reference for an API on another host (fingerprint.py);
# unset, it is computed from this checkout.
#GATE_REQUIRED_FINGERPRINT=
# A kernel at or below this ratio to the incumbent qualifies for promotion; it is also the
# only ratio the weight setter pays.
PROMOTION_BAR=0.97

# --- The store --------------------------------------------------------------------
# Postgres from compose.yaml. DATABASE_URL, if set, overrides all five.
POSTGRES_USER=conjectures
POSTGRES_PASSWORD=change-me
POSTGRES_DB=floatlib
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
#DATABASE_URL=postgresql+psycopg://user:pass@host:5433/floatlib

# --- The submission API -----------------------------------------------------------
SERVICE_HOST=0.0.0.0
SERVICE_PORT=9300
# Submissions keep Kernel.lean in the store; this is only where ones queued before that
# (migration 0006) still have theirs. Relative to the repository.
SERVICE_FILES=validator/.work/submissions
# Signed writes per hotkey per minute.
SERVICE_RATE_PER_MINUTE=10
# How far a submission's signed timestamp may be from the validator's clock.
SERVICE_SIGNATURE_WINDOW_SECONDS=300
# Host header allowlist, comma-separated; "*" behind a filtering proxy.
SERVICE_ALLOWED_HOSTS=*
# Unique per gate worker; the default carries the hostname and pid. Keep it stable across
# restarts (pm2 sets <hostname>-pm2) so a restarted worker requeues its own claims at once.
#SERVICE_WORKER_ID=
# Must exceed VERIFY_TOTAL_TIMEOUT, or a slow but live verification gets stolen.
#SERVICE_STALE_CLAIM_SECONDS=7200
# Gate crashes on one submission before it is given up as `error`, uncharged.
#SERVICE_MAX_GATE_ERRORS=3

# --- The chain (./setup.sh --chain) -----------------------------------------------
NETUID=66
BITTENSOR_NETWORK=finney
BITTENSOR_ARCHIVE_NETWORK=archive
#CHAIN_POLL_SECONDS=6
# The validator's own wallet; its hotkey must be registered on NETUID.
BITTENSOR_WALLET_NAME=default
BITTENSOR_WALLET_HOTKEY=default
#BITTENSOR_WALLET_PATH=~/.bittensor/wallets
# Record the vector without submitting it. On unless set to 0: only one process may set
# weights per validator hotkey, so decide which competition's does before turning it off.
#WEIGHT_DRY_RUN=1
# The vector is the whole validator's: the treasury (uid 121 on netuid 66) and the
# competition's share (20% on netuid 66), both code constants on mainnet (validator/treasury.py).
# Off mainnet both are configurable; the treasury defaults to WEIGHT_BURN_UID.
#WEIGHT_TREASURY_UID=
#WEIGHT_COMPETITION_SHARE=0.2
# The treasury's registered hotkey: an epoch where it is not where expected is skipped.
#WEIGHT_TREASURY_HOTKEY=
# Burn the competition's share, ignoring scores (a paused round); the treasury is still paid.
#WEIGHT_BURN_MODE=1
#WEIGHT_BURN_UID=121
# Every slot's leader receives an equal part of the competition's budget (validator/reward.py);
# this is the share of that part a leader keeps (king of the hill); the treasury takes the rest.
#WEIGHT_WINNER_SHARE=1.0

# --- The conjectures platform (README, "Serving through the conjectures platform") ---
# The password of the platform API's database role; deploy/platform/grant.sh creates or
# rotates it and resets its grants.
#PLATFORM_API_PASSWORD=
# Attach the database to the platform stack's network (a host running both).
#COMPOSE_FILE=compose.yaml:deploy/platform/compose.yaml
#PLATFORM_NETWORK=conjectures-api_default

# --- Observability: events to the platform's Axiom dataset ------------------------
# Both required, or events are off; the platform's names and meanings (validator/axiom.py).
#AXIOM_TOKEN=
#AXIOM_DATASET=conjectures-validator
# A free-form deployment tag on every event.
#AXIOM_ENVIRON=default
#AXIOM_URL=https://api.axiom.co
